# API Configuration
API_KEYS=your-secret-key-here,another-key-here

# Cache settings (seconds)
CACHE_TTL=3600

# Batch processing limits
MAX_BATCH=5

# Request timeout (seconds)
REQUEST_TIMEOUT=85

# US delivery location
US_ZIP=10001
REQUIRE_US_ZIP=0

# Retry settings
MAX_RETRIES=2

# Proxy (optional)
# PROXY_URL=http://proxy:port
